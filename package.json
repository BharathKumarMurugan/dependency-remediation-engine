{
  "name": "dependency-remediation-engine",
  "version": "1.0.0",
  "description": "An automated, local-first dependency vulnerability scanner, auto-updater, and structural refactoring (AST) companion tool designed to safely remediate security advisories within the local development environment.",
  "type": "module",
  "main": "dist/index.ts",
  "bin": {
    "remediate": "dist/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "test": "jest",
    "prepare": "node scripts/install-hooks.js",
    "pre-push": "node scripts/pre-push-check.js"
  },
  "keywords": [
    "vulnerability",
    "remediation",
    "refactoring",
    "ast-refactoring",
    "security",
    "vulnerability-scanner",
    "dependency-updater",
    "semver",
    "ast-grep"
  ],
  "author": "Bharath Kumar Murugan <bharathkumarmurugan2016@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BharathKumarMurugan/dependency-remediation-engine.git"
  },
  "bugs": {
    "url": "https://github.com/BharathKumarMurugan/dependency-remediation-engine/issues"
  },
  "homepage": "https://github.com/BharathKumarMurugan/dependency-remediation-engine#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.45.1",
    "@clack/prompts": "^1.7.0",
    "async-mutex": "^0.5.0",
    "axios": "^1.19.0",
    "p-limit": "^3.1.0",
    "piscina": "^5.3.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/semver": "^7.8.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
